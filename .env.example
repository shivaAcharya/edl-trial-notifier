# ── Shared ntfy push notification topic ──────────────────────────────────────
# Everyone subscribes to this topic in the ntfy app to get slot alerts.
# Keep this name private — anyone who knows it can subscribe.
NTFY_TOPIC=your-private-topic-name-here

# ── Polling settings (apply to all users) ────────────────────────────────────
POLL_INTERVAL_SECONDS=300
SCAN_DAYS_AHEAD=60

# Per-user config (booking URL and bearer token) lives in users.json.
# Copy users.json.example to users.json and fill in the values.
