# ── Twilio credentials ────────────────────────────────────────────────────────
# Get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# ── Notification target ───────────────────────────────────────────────────────
# Include country code (e.g. +9779740841997 for Nepal, +1XXXXXXXXXX for US)
TO_PHONE_NUMBER=+977XXXXXXXXXX

# ── Applicant booking URL ─────────────────────────────────────────────────────
# The full URL from the EDL portal — the last segment is the application UUID
BOOKING_URL=https://edlvrs.lumbini.gov.np/edl/YOUR-APPLICATION-UUID-HERE

# ── Polling settings ──────────────────────────────────────────────────────────
POLL_INTERVAL_SECONDS=300
SCAN_DAYS_AHEAD=60
